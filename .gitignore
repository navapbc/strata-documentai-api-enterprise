.DS_Store

# --- Secrets / sensitive files (repo-wide safety net) ---
# These should never be committed. Patterns are unanchored so they match at any depth.
.env
.env.*
!.env.example
!*.env.example
*.pem
*.key
*.p12
*.pfx
credentials
*.credentials

# --- Terraform local state / secrets ---
# State can contain secrets in plaintext; never commit it.
*.tfstate
*.tfstate.*
.terraform/
*.tfvars.local
crash.log
crash.*.log

# VHS tape recording artifact - cloned by api-setup-demo.tape, cleaned up in teardown
strata-documentai-api-enterprise/

# Generated MP4s from gifs-to-mp4 target (keep api-setup-demo.mp4 which is VHS-recorded and referenced in docs)
docs/documentai-api/media/*.mp4
!docs/documentai-api/media/api-setup-demo.mp4
