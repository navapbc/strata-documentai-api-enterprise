FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    pandoc \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libharfbuzz0b \
    libfontconfig1 \
    fonts-noto-color-emoji \
    wget \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /usr/share/fonts/plus-jakarta-sans \
    && wget -q "https://github.com/tokotype/PlusJakartaSans/raw/master/fonts/ttf/PlusJakartaSans-Regular.ttf" -O /usr/share/fonts/plus-jakarta-sans/PlusJakartaSans-Regular.ttf \
    && wget -q "https://github.com/tokotype/PlusJakartaSans/raw/master/fonts/ttf/PlusJakartaSans-Italic.ttf" -O /usr/share/fonts/plus-jakarta-sans/PlusJakartaSans-Italic.ttf \
    && wget -q "https://github.com/tokotype/PlusJakartaSans/raw/master/fonts/ttf/PlusJakartaSans-Medium.ttf" -O /usr/share/fonts/plus-jakarta-sans/PlusJakartaSans-Medium.ttf \
    && wget -q "https://github.com/tokotype/PlusJakartaSans/raw/master/fonts/ttf/PlusJakartaSans-SemiBold.ttf" -O /usr/share/fonts/plus-jakarta-sans/PlusJakartaSans-SemiBold.ttf \
    && wget -q "https://github.com/tokotype/PlusJakartaSans/raw/master/fonts/ttf/PlusJakartaSans-Bold.ttf" -O /usr/share/fonts/plus-jakarta-sans/PlusJakartaSans-Bold.ttf \
    && wget -q "https://github.com/tokotype/PlusJakartaSans/raw/master/fonts/ttf/PlusJakartaSans-BoldItalic.ttf" -O /usr/share/fonts/plus-jakarta-sans/PlusJakartaSans-BoldItalic.ttf \
    && fc-cache -f

RUN pip install --no-cache-dir weasyprint==60.2 pydyf==0.10.0

COPY tests/e2e/extraction_compare_charts/render_pdf.py /render_pdf.py

WORKDIR /data

ENTRYPOINT ["python", "/render_pdf.py"]
