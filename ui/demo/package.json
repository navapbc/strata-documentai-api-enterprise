{
  "name": "docai-demo-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "esbuild src/main.js styles/style.css --bundle --outdir=dist --outbase=. --sourcemap --watch --serve=3001 --servedir=. --loader:.html=text",
    "build": "esbuild src/main.js styles/style.css --bundle --outdir=dist --outbase=. --minify --loader:.html=text",
    "lint": "eslint src/ tests/ e2e/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write src/ styles/ tests/ e2e/ ../shared/ index.html",
    "format:check": "prettier --check src/ styles/ tests/ e2e/ ../shared/ index.html"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "jsdom": "^30.0.1",
    "otplib": "^13.5.0",
    "prettier": "^3.9.6",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
