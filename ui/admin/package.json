{
  "name": "docai-admin-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node scripts/gen-build-info.js && esbuild bundle=src/main.js style=styles/style.css --bundle --outdir=dist --sourcemap --watch --serve=3000 --servedir=. --loader:.html=text",
    "build": "node scripts/gen-build-info.js && esbuild bundle=src/main.js style=styles/style.css --bundle --outdir=dist --minify --loader:.html=text",
    "lint": "eslint src/ tests/ e2e/",
    "pretest": "node scripts/gen-build-info.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "record": "playwright test --config=playwright.video.config.js",
    "format": "prettier --write src/ styles/ tests/ e2e/ ../shared/ index.html",
    "format:check": "prettier --check src/ styles/ tests/ e2e/ ../shared/ index.html",
    "preview": "python3 -m http.server 3000"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "qrcode": "^1.5.4"
  }
}
